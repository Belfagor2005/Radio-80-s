msgid "Cancel"
msgstr "ሰርዝ"

msgid "Cancel execution?"
msgstr "ማስፈጸሚያ ይሰረዝ?"

msgid "Congrats! You already have the latest version..."
msgstr "እንኳን ደስ ያለህ! ቀደም ሲል የቅርብ ጊዜ ስሪት አለህ..."

msgid "Console"
msgstr "ኮንሶል"

msgid "Dj:"
msgstr "ዲጄ፡"

msgid "Do you want to install update ( %s ) now?"
msgstr "ማሻሻያ (%s) አሁን መጫን ይፈልጋሉ?"

msgid "Error retrieving song"
msgstr "ዘፈን ሰርስሮ ማውጣት ላይ ስህተት"

msgid "Exit"
msgstr "ውጣ"

msgid "Hide/Show"
msgstr "ደብቅ/ አሳይ"

msgid "Online:"
msgstr "መስመር ላይ፡"

msgid "Restart"
msgstr "እንደገና ጀምር"

msgid "Select"
msgstr "ይምረጡ"

msgid "Select and Play"
msgstr "ይምረጡ እና ይጫወቱ"

msgid "Unknown Title"
msgstr "ያልታወቀ ርዕስ"

msgid "Update"
msgstr "አዘምን"

msgid "Update Aborted!"
msgstr "ዝማኔ ተቋርጧል!"
